+/* SPIMARIMMO stand glyph.
+
+   Occupies the same role as the reference's four-point star device: a small,
+   repeated, single-colour mark drawn in a 39x39 box so it reads cleanly between
+   18px and 36px, and so the cluster geometry transfers unchanged.
+
+   Where the reference star is abstract, this is the object SPIMARIMMO actually
+   sells — an exhibition stand seen head-on: canopy, two posts, counter. Drawn
+   with the same even-odd fill and axial symmetry so it sits in the composition
+   the way the star did, rather than reading as a pasted-in icon. */
+export function SpimarStandGlyph() {
+  return (
+    <svg
+      width="39"
+      height="39"
+      viewBox="0 0 39 39"
+      fill="none"
+      xmlns="http://www.w3.org/2000/svg"
+      aria-hidden="true"
+    >
+      {/* Built the way the reference glyph is built, not copied from it.
+
+          The reference mark is one path in a 39x39 box, mirrored on both axes,
+          where every curve is a single arc cut into a straight-edged form, and
+          the counter-shape is carried by an even-odd fill rather than by a
+          second colour. Those are the construction rules; this follows them.
+
+          The form is a stand portal: a square frame with a pointed-arch void.
+          The frame is the stand, the arch is the way in. The arch is a Moroccan
+          pointed horseshoe rather than a plain semicircle — geometry the
+          specification asks for as editorial depth, not applied ornament.
+
+          Mirrored on the vertical axis, so it holds at 18px and at 35px, and
+          reads as a mark rather than as an illustration of a booth. */}
+      <path
+        fillRule="evenodd"
+        clipRule="evenodd"
+        d="M6 33V20C6 12 12 6 19.5 4C27 6 33 12 33 20V33H27V21C27 16 24 12 19.5 10.5C15 12 12 16 12 21V33H6ZM3 34H36V37H3V34Z"
+        fill="currentColor"
+      />
+    </svg>
+  );
+}
