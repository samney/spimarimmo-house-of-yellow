# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude/playwright artifacts
.playwright-mcp/


# Reference captures + recordings: regenerable evidence, disk-only (see DECISIONS D-006)
qa/reference/**/*.png
qa/reference/**/*.jpg
qa/reference/**/*.jpeg
qa/recordings/*.webm

# Large local video corpus: keep out of Git; deploy through external object/CDN storage.
/public/videos/

# Codex-generated audit evidence and local runtime output.
/qa/codex/
/.codex-server.*.log
/test-results/

# Local contact-submission store (substitute until Supabase, HOY-100)
/.data/
