# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude/playwright artifacts
.playwright-mcp/

# Nested Claude Code worktrees. `EnterWorktree` creates linked worktrees here,
# each a full checkout of this repository. They must never be committed: a
# `git add -A` from any session would otherwise vendor an entire second copy of
# the tree. See also the matching Vitest exclude in `vitest.config.mjs`.
.claude/worktrees/


# Reference captures + recordings: regenerable evidence, disk-only (see DECISIONS D-006)
qa/reference/**/*.png
qa/reference/**/*.jpg
qa/reference/**/*.jpeg
qa/recordings/*.webm
# ENG-014C implementation captures: regenerable via qa/eng014c-audit.mjs, disk-only
qa/implementation/eng014c/
# ENG-014C raw evidence package: path, size and SHA-256 recorded in the parity report
qa/implementation/ENG-014C-EVIDENCE-PACKAGE.zip

# Large local video corpus: keep out of Git; deploy through external object/CDN storage.
# (Contents, not the directory itself: Git cannot re-include a file inside an
# excluded directory, so the exception below would never apply.)
/public/videos/*
# Exception: manifest-declared, rights-approved assets ship with the repository
# so they actually deploy. Keep this list short — anything sizeable belongs in
# object storage, which is what the rule above is for. (D-024)
!/public/videos/hero-real-estate-exhibition.mp4

# Codex-generated audit evidence and local runtime output.
/qa/codex/
/.codex-server.*.log
/test-results/
/playwright-report/

# Backend QA evidence: JSON reports are committed as executed evidence.
# Only regenerable binary/visual output is excluded.
qa/backend/**/*.png
qa/backend/**/*.jpg
qa/backend/**/*.jpeg
qa/backend/**/*.webm

# Local contact-submission store (substitute until Supabase, HOY-100)
/.data/
supabase/.temp/
