# SPIMAR environment contract
#
# Names and safe explanations only. Never commit real values.
# Never copy a secret or service-role key into a NEXT_PUBLIC_* variable:
# NEXT_PUBLIC_* is inlined into the browser bundle.
#
# The approved contract is documented in
# docs/spimar/official-specifications/11-Implementation-and-QA/01-ENGINEERING-INTAKE-STATUS.md

# --- Public site ---
# Canonical public site URL.
NEXT_PUBLIC_SITE_URL=

# --- Browser-safe Supabase configuration (public by design) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Client-safe key. Database authorization still depends entirely on RLS.
# Supabase now calls this the "publishable" key; both names are listed while
# the platform migration completes. Set the one your client library expects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only Supabase access ---
# Must never enter client bundles, logs or public config.
SUPABASE_SERVICE_ROLE_KEY=
# Server/migration use only. Confirm pooling and SSL requirements.
SUPABASE_DATABASE_URL=

# --- Contact / notification (public site) ---
# Recipient ownership must be approved before activation.
CONTACT_NOTIFICATION_TO=
EMAIL_PROVIDER_API_KEY=
# Sender-domain verification pending.
EMAIL_FROM_ADDRESS=
# Long random value. Rotation runbook pending.
CONTACT_RATE_LIMIT_SECRET=

# --- Preview and revalidation ---
# Long random values. Timing-safe validation and rotation required.
PREVIEW_SECRET=
REVALIDATION_SECRET=

# --- Bot protection ---
# Site key is public-by-function; secret key is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================================
# Supabase Edge Function configuration
# Set these as Supabase Function secrets. They are never read by Next.js and
# must never be added to Vercel client-side environment variables.
# ============================================================================

# Comma-separated allowed origins per function. No wildcards in production.
LEAD_ALLOWED_ORIGINS=
CMS_ALLOWED_ORIGINS=
CRM_ALLOWED_ORIGINS=

# Server-side secret used to derive non-reversible duplicate-detection hashes
# for submissions. Rotating it breaks duplicate linkage; treat as durable.
FORM_HASH_SECRET=

# "true" requires a verified Turnstile token before a submission is accepted.
TURNSTILE_REQUIRED=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=

# Public acquisition rate limiting: accepted submissions per window, and the
# window length in seconds.
LEAD_RATE_LIMIT=
LEAD_RATE_WINDOW_SECONDS=

# Retryable CRM integration worker. Store only in Supabase/Vault.
# Shared secret authenticating the scheduled worker invocation.
WORKER_SHARED_SECRET=
# Jobs claimed per worker run, and the lock lease before a job is reclaimed.
WORKER_BATCH_SIZE=
WORKER_LOCK_TIMEOUT_SECONDS=

# Outbound notification provider used by the Edge functions.
RESEND_API_KEY=
# Display name and address used as the notification sender.
EMAIL_FROM=
# Private internal inbox that receives CRM notifications. Never a public address.
CRM_NOTIFICATION_TO=

# Optional downstream CRM webhook. Leave blank to disable.
# The secret signs the outbound payload.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Note: Supabase injects SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS and
# SUPABASE_SECRET_KEYS into hosted Edge Functions automatically. Do not
# redeclare them here and never expose SUPABASE_SECRET_KEYS to the client.
